{
  "name": "extension-name-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update": "node -e \"process.platform==='linux'||(console.error('\\n[test:update] Reference screenshots must be generated on Linux (inside the pinned Playwright Docker image). Use npm run test:update:docker.\\n'),process.exit(1))\" && vitest run --update",
    "test:docker": "node scripts/docker-test.mjs test",
    "test:update:docker": "node scripts/docker-test.mjs test:update",
    "test:coverage": "vitest run --coverage --exclude \"**/*.visual.test.tsx\"",
    "test:coverage:full": "vitest run --coverage",
    "test:coverage:docker": "node scripts/docker-test.mjs test:coverage:full",
    "format": "prettier --write \"**/*.{ts,tsx,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,html}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@sbb-polarion/react-sbb-polarion": "^2.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-istanbul": "5.0.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "playwright": "1.64.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "vitest-browser-react": "2.3.0"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "npm": ">=12"
  },
  "packageManager": "npm@12.2.0",
  "allowScripts": {
    "esbuild": true
  }
}
